From e31e5a65d9e2dea53a4abec2359e7a43cde250ff Mon Sep 17 00:00:00 2001
From: Dawid Karczewski <goliat931@gmail.com>
Date: Sat, 30 May 2026 21:49:13 +0200
Subject: [PATCH] fix(config): Rename ConfigFlow class and fix DOMAIN mismatch-
 Rename AwentaConfigFlow to ConfigFlow (required by Home Assistant)- Fix
 DOMAIN from 'awenta' to 'awenta_ahr' to match manifest.json- Add test suite
 with pytest (conftest.py, test_awenta_api.py, test_config_flow.py)- Add
 requirements-test.txt for easy test setup

---
 custom_components/awenta_ahr/config_flow.py   |   2 +-
 custom_components/awenta_ahr/const.py         |   2 +-
 custom_components/awenta_ahr/manifest.json    |   2 +-
 pytest.ini                                    |   6 ++
 requirements-test.txt                         |   7 ++
 .../conftest.cpython-314-pytest-7.4.3.pyc     | Bin 0 -> 1921 bytes
 ...st_awenta_api.cpython-314-pytest-7.4.3.pyc | Bin 0 -> 9971 bytes
 ...t_config_flow.cpython-314-pytest-7.4.3.pyc | Bin 0 -> 5478 bytes
 tests/conftest.py                             |  51 +++++++++++++
 tests/test_awenta_api.py                      |  68 ++++++++++++++++++
 tests/test_config_flow.py                     |  41 +++++++++++
 11 files changed, 176 insertions(+), 3 deletions(-)
 create mode 100644 pytest.ini
 create mode 100644 requirements-test.txt
 create mode 100644 tests/__pycache__/conftest.cpython-314-pytest-7.4.3.pyc
 create mode 100644 tests/__pycache__/test_awenta_api.cpython-314-pytest-7.4.3.pyc
 create mode 100644 tests/__pycache__/test_config_flow.cpython-314-pytest-7.4.3.pyc
 create mode 100644 tests/conftest.py
 create mode 100644 tests/test_awenta_api.py
 create mode 100644 tests/test_config_flow.py

diff --git a/custom_components/awenta_ahr/config_flow.py b/custom_components/awenta_ahr/config_flow.py
index d9feef6..e7e0bdc 100644
--- a/custom_components/awenta_ahr/config_flow.py
+++ b/custom_components/awenta_ahr/config_flow.py
@@ -12,7 +12,7 @@ DATA_SCHEMA = vol.Schema(
 )
 
 
-class AwentaConfigFlow(config_entries.ConfigFlow, domain=DOMAIN):
+class ConfigFlow(config_entries.ConfigFlow, domain=DOMAIN):
 
     async def async_step_user(self, user_input=None):
 
diff --git a/custom_components/awenta_ahr/const.py b/custom_components/awenta_ahr/const.py
index 614d138..d3a5019 100644
--- a/custom_components/awenta_ahr/const.py
+++ b/custom_components/awenta_ahr/const.py
@@ -1,4 +1,4 @@
-DOMAIN = "awenta"
+DOMAIN = "awenta_ahr"
 
 PLATFORMS = ["fan", "sensor", "select"]
 
diff --git a/custom_components/awenta_ahr/manifest.json b/custom_components/awenta_ahr/manifest.json
index afda01f..f40e7e3 100644
--- a/custom_components/awenta_ahr/manifest.json
+++ b/custom_components/awenta_ahr/manifest.json
@@ -4,8 +4,8 @@
   "version": "1.0.0",
   "documentation": "https://github.com/MateiiK/awenta_ha",
   "issue_tracker": "https://github.com/MateiiK/awenta_ha/issues",
+  "requirements": ["websockets>=12.0"],
   "config_flow": true,
   "iot_class": "cloud_push",
-  "requirements": ["websockets>=12.0"],
   "codeowners": ["MateiiK"]
 }
diff --git a/pytest.ini b/pytest.ini
new file mode 100644
index 0000000..cdce43f
--- /dev/null
+++ b/pytest.ini
@@ -0,0 +1,6 @@
+[pytest]
+asyncio_mode = auto
+testpaths = tests
+python_files = test_*.py
+python_classes = Test*
+python_functions = test_*
